{
  "name": "alerterobot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --use-env-proxy ./node_modules/next/dist/bin/next dev -p 3500",
    "build": "next build",
    "start": "node --use-env-proxy ./node_modules/next/dist/bin/next start -p 3500",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-sql.ps1",
    "worker:abidjan": "node --env-file=.env.local worker/verificateur.ts abidjan",
    "worker:paris": "node --env-file=.env.local worker/verificateur.ts paris",
    "worker:notifieur": "node --env-file=.env.local --use-env-proxy worker/notifieur.ts",
    "vapid": "node -e \"const w=require('web-push');console.log(w.generateVAPIDKeys())\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "undici": "^7.16.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
