# Copier en .env.local (jamais versionné). Les variables NEXT_PUBLIC_* sont visibles
# dans le navigateur : n'y mettre aucun secret.

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : serveur Next et workers uniquement.
SUPABASE_SERVICE_ROLE_KEY=

# Console /admin : emails des administrateurs de la plateforme, séparés par des virgules.
# Pour tout autre visiteur, /admin répond 404.
ALERTEROBOT_ADMIN_EMAILS=

# Adresse publique de l'application (liens des emails et des notifications).
APP_URL=http://localhost:3500

# Email (Resend). Sans clé, les emails s'écrivent dans la console du notifieur.
RESEND_API_KEY=
EMAIL_FROM=AlerteRobot <alertes@votre-domaine.ci>

# Web Push : npm run vapid. La clé privée est un secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:securite@votre-domaine.ci

# Signature des liens de confirmation et de désabonnement des pages de statut.
# Secret de 32 caractères au moins : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ALERTEROBOT_SECRET_LIENS=

# Telegram : robot créé avec @BotFather. Le jeton est un secret (notifieur seulement) ;
# le nom (sans @) sert au lien « Relier un groupe » de la page Intégrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NOM=

# Worker : nombre de vérifications en parallèle.
WORKER_PARALLELE=20
